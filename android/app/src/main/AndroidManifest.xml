<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량(AAOS) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 실제로 쓰는 API의 권한만 선언: 누적 주행거리(Odometer)·기어(Gear) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 순정 내비 목적지·경로 정보 조회(NaviHelper getDestinationInfo·getRouteStateInfo, Normal) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Namunkiro">
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Namunkiro"
            android:windowSoftInputMode="adjustResize">
            <!-- 주행 중에는 최소 잠금 화면만 표시한다(DEV_PLAN 1절 결정 사항) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
